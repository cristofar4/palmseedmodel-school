# ---------------------------------------------------------------------------
# Palmseed Model School - environment configuration
#
# Copy to .env.local for local development. In production set these in the
# Vercel project settings under Settings > Environment Variables.
# Never commit a filled in copy of this file.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Supabase: Project Settings > Database > Connection string > URI.
# Use the Session pooler (port 5432) or Transaction pooler (port 6543) URI.
# Must include sslmode=require for Supabase.
DATABASE_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# --- Application ----------------------------------------------------------
# Public origin of the deployment. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ byte random secret used to derive signed cookie and token keys.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Email (Resend) -------------------------------------------------------
# https://resend.com/api-keys
# When RESEND_API_KEY is empty the application runs in outbox mode: every
# message is still validated, rendered and recorded in the email_logs table
# and written to .mail-outbox/ for inspection, but nothing leaves the server.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
EMAIL_FROM=Palmseed Model School <noreply@MY_VERIFIED_DOMAIN>
EMAIL_REPLY_TO=christopherpraise864@gmail.com
ADMIN_NOTIFICATION_EMAIL=christopherpraise864@gmail.com

# --- Supabase Storage (optional) -----------------------------------------
# Only required for profile photograph and admission document uploads.
# The service role key must never be exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Administrator bootstrap ---------------------------------------------
# Consumed once by `npm run admin:create`, then can be removed.
# Use a long random value. Do not reuse a personal password.
ADMIN_BOOTSTRAP_EMAIL=christopherpraise864@gmail.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Palmseed Administrator
